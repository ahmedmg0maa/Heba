# Supabase (public — safe for browser). Use the hosting environment variables;
# this repository intentionally contains names only, never values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (SERVER ONLY — never expose to the browser, never prefix with NEXT_PUBLIC_)
# Preferred: an independently revocable sb_secret key. The legacy service-role
# variable is transitional only and must be removed from deployed environments after cutover.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_LOGIN_EMAIL=

# Transactional email (SERVER ONLY). Both names are required before the
# outbox adapter can send; never use a personal mailbox password here.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Error monitoring. Runtime DSNs are configuration, while SENTRY_AUTH_TOKEN is
# build/CI-only for artifact upload and must never enter the browser bundle.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_AUTH_TOKEN=

# Optional server-side malware scanning hook. When configured, upload publication
# fails closed unless the endpoint returns JSON: {"verdict":"clean"}.
PROTECTED_UPLOAD_SCAN_URL=
PROTECTED_UPLOAD_SCAN_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=

# Hosting environment. Set HEBA_DEPLOYMENT_ENV=staging only on the isolated
# staging application. Both staging access variables are required there and
# deliberately omitted from source control.
HEBA_DEPLOYMENT_ENV=
STAGING_ACCESS_USER=
STAGING_ACCESS_PASSWORD=

# Seeding (never true in production)
SEED_DEMO=false
