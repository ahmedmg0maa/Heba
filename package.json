{
  "name": "heba-elsherif-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:isolated": "node scripts/run-isolated-build.mjs",
    "build:cloudflare:isolated": "node scripts/run-cloudflare-isolated-build.mjs",
    "build:cloudflare:staging:isolated": "node scripts/run-cloudflare-isolated-build.mjs --env=staging",
    "start": "next start",
    "start:isolated-preview": "node scripts/start-isolated-preview.mjs",
    "lint": "eslint",
    "type-check": "node scripts/run-isolated-typecheck.mjs",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop-chromium",
    "test:e2e:public": "playwright test tests/e2e/public.spec.ts --project=desktop-chromium --project=mobile-chromium",
    "test:e2e:cloudflare": "pnpm build:cloudflare:isolated && playwright test tests/e2e/public.spec.ts --config playwright.cloudflare.config.ts",
    "verify:booking": "node --env-file=.env scripts/verify-booking-rpc.mjs",
    "verify:booking-local": "node scripts/verify-booking-local.mjs",
    "verify:booking-permissions-local": "node scripts/verify-booking-permissions-local.mjs",
    "verify:booking-staging-contract": "node scripts/verify-booking-staging-contract.mjs --mode=source",
    "verify:booking-staging-contract-fixtures": "node scripts/verify-booking-staging-contract.mjs --mode=preflight --snapshot=tests/fixtures/staging-booking-preflight-snapshot.json && node scripts/verify-booking-staging-contract.mjs --mode=postflight --snapshot=tests/fixtures/staging-booking-postflight-snapshot.json",
    "verify:fresh-admin-assurance": "node scripts/verify-fresh-admin-assurance.mjs",
    "verify:report-export-local": "node scripts/verify-report-export-local.mjs",
    "verify:home-cms-local": "node scripts/verify-home-cms-local.mjs",
    "verify:public-search-local": "node scripts/verify-public-search-local.mjs",
    "verify:start-here-cms-local": "node scripts/verify-start-here-cms-local.mjs",
    "verify:guided-assessment-local": "node scripts/verify-guided-assessment-local.mjs",
    "verify:program-catalog-local": "node scripts/verify-program-catalog-local.mjs",
    "verify:catalog-publication-local": "node scripts/verify-catalog-publication-local.mjs",
    "verify:media-lifecycle-local": "node scripts/verify-media-lifecycle-local.mjs",
    "verify:newsletter-governance-local": "node scripts/verify-newsletter-governance-local.mjs",
    "verify:admin-security-center-local": "node scripts/verify-admin-security-center-local.mjs",
    "verify:admin-read-integrity-local": "node scripts/verify-admin-read-integrity-local.mjs",
    "verify:resend-outbox-local": "node scripts/verify-resend-outbox-local.mjs",
    "verify:customer-360-local": "node scripts/verify-customer-360-local.mjs",
    "verify:sentry-monitoring-local": "node --experimental-strip-types scripts/verify-sentry-monitoring-local.mjs",
    "verify:admin-notifications-local": "node scripts/verify-admin-notifications-local.mjs",
    "verify:admin-role-governance-local": "node scripts/verify-admin-role-governance-local.mjs",
    "verify:booking-admin-governance-local": "node scripts/verify-booking-admin-governance-local.mjs",
    "verify:commerce-admin-governance-local": "node scripts/verify-commerce-admin-governance-local.mjs",
    "verify:checkout-upload-governance-local": "node scripts/verify-checkout-upload-governance-local.mjs",
    "verify:customer-learning-governance-local": "node scripts/verify-customer-learning-governance-local.mjs",
    "verify:customer-protected-delivery-local": "node scripts/verify-customer-protected-delivery-local.mjs",
    "verify:customer-dashboard-read-integrity-local": "node scripts/verify-customer-dashboard-read-integrity-local.mjs",
    "verify:customer-account-governance-local": "node scripts/verify-customer-account-governance-local.mjs",
    "verify:revision-recovery-local": "node scripts/verify-revision-recovery-local.mjs",
    "verify:admin-operations-ux-local": "node scripts/verify-admin-operations-ux-local.mjs",
    "verify:contact-governance-local": "node scripts/verify-contact-governance-local.mjs",
    "verify:testimonial-governance-local": "node scripts/verify-testimonial-governance-local.mjs",
    "verify:press-governance-local": "node scripts/verify-press-governance-local.mjs",
    "verify:resource-hub-local": "node scripts/verify-resource-hub-local.mjs",
    "verify:recovery-runner-local": "node scripts/verify-recovery-runner-local.mjs",
    "verify:permissions": "node --env-file=.env scripts/verify-permissions.mjs",
    "verify:admin-controls": "node --env-file=.env scripts/verify-admin-controls.mjs",
    "verify:media": "node --env-file=.env scripts/verify-media.mjs",
    "verify:commerce": "node --env-file=.env scripts/verify-commerce.mjs",
    "verify:commerce-integrity": "node --env-file=.env scripts/verify-commerce-integrity.mjs",
    "verify:delivery": "node --env-file=.env scripts/verify-delivery.mjs",
    "verify:delivery-local": "node scripts/verify-delivery-local.mjs",
    "verify:archive-security": "node scripts/verify-archive-security.mjs",
    "verify:cms": "node --env-file=.env scripts/verify-cms.mjs",
    "verify:crm": "node --env-file=.env scripts/verify-crm.mjs",
    "verify:booking-credits": "node --env-file=.env scripts/verify-booking-credits.mjs",
    "audit:routes": "node scripts/audit-routes.mjs",
    "audit:ux": "node scripts/audit-ux.mjs",
    "audit:colors": "node scripts/audit-colors.mjs",
    "audit:security": "node scripts/audit-security.mjs",
    "package:release": "node scripts/package-release.mjs",
    "deliver": "pnpm audit:security && pnpm check:deploy && pnpm package:release && pnpm audit:security",
    "audit:admin": "node scripts/audit-admin.mjs",
    "audit:media": "node scripts/audit-media.mjs",
    "audit:commerce": "node scripts/audit-commerce.mjs",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "audit:booking": "node scripts/audit-booking.mjs",
    "audit:cms-local": "node scripts/audit-cms-local.mjs",
    "audit:db": "node scripts/audit-db.mjs",
    "audit:launch": "node scripts/audit-launch.mjs",
    "audit:remediation-local": "node scripts/audit-remediation-local.mjs",
    "db:seed": "node scripts/seed.mjs",
    "check:deploy": "pnpm type-check && pnpm lint && pnpm verify:archive-security && pnpm verify:delivery-local && pnpm verify:booking-local && pnpm verify:booking-permissions-local && pnpm verify:booking-staging-contract && pnpm verify:booking-staging-contract-fixtures && pnpm verify:fresh-admin-assurance && pnpm verify:report-export-local && pnpm verify:home-cms-local && pnpm verify:public-search-local && pnpm verify:start-here-cms-local && pnpm verify:guided-assessment-local && pnpm verify:catalog-publication-local && pnpm verify:program-catalog-local && pnpm verify:media-lifecycle-local && pnpm verify:newsletter-governance-local && pnpm verify:admin-security-center-local && pnpm verify:admin-read-integrity-local && pnpm verify:resend-outbox-local && pnpm verify:customer-360-local && pnpm verify:sentry-monitoring-local && pnpm verify:admin-notifications-local && pnpm verify:admin-role-governance-local && pnpm verify:booking-admin-governance-local && pnpm verify:commerce-admin-governance-local && pnpm verify:checkout-upload-governance-local && pnpm verify:customer-learning-governance-local && pnpm verify:customer-protected-delivery-local && pnpm verify:customer-dashboard-read-integrity-local && pnpm verify:customer-account-governance-local && pnpm verify:revision-recovery-local && pnpm verify:admin-operations-ux-local && pnpm verify:contact-governance-local && pnpm verify:testimonial-governance-local && pnpm verify:press-governance-local && pnpm verify:resource-hub-local && pnpm verify:recovery-runner-local && pnpm audit:cms-local && pnpm audit:remediation-local && pnpm build:isolated && pnpm test:e2e:public && pnpm audit:routes && pnpm audit:ux && pnpm audit:colors && pnpm audit:security && pnpm audit:admin && pnpm audit:media && pnpm audit:commerce && pnpm audit:catalog && pnpm audit:booking && pnpm audit:db && pnpm audit:launch",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:cloudflare:staging": "pnpm build:cloudflare:staging:isolated && wrangler deploy --config dist/server/wrangler.json --keep-vars"
  },
  "dependencies": {
    "@sentry/browser": "10.55.0",
    "@sentry/cloudflare": "10.55.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "next": "16.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "wrangler": "^4.126.0"
  },
  "type": "module"
}
